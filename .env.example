# Environment Configuration Template

# MT5 Docker & VNC Credentials
MT5_VNC_PORT=8088
MT5_RPYC_PORT=8081
MT5_VNC_USER=fendi
MT5_VNC_PASSWORD=fendi123

# Web & API Security
FRONTEND_PORT=3000
SECRET_KEY=change-me-to-a-secure-random-32-byte-hex
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALLOWED_HOSTS=localhost,127.0.0.1,100.72.94.17

# Admin Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password

# MT5 Bridge Settings
BRIDGE_API_PORT=8089
BRIDGE_POLL_INTERVAL_MS=500
MT5_MAGIC_NUMBER=778899

# Risk Management Defaults
MAX_DAILY_DRAWDOWN_PERCENT=3.0
DEFAULT_RISK_PER_TRADE_PERCENT=1.0
MAX_SPREAD_POINTS=35

# Technical Analysis & Scalping Strategy Engine
STRATEGY_ENABLED=true
STRATEGY_EMA_FAST=9
STRATEGY_EMA_SLOW=21
STRATEGY_RSI_PERIOD=14
STRATEGY_RSI_OVERSOLD=32.0
STRATEGY_RSI_OVERBOUGHT=68.0
STRATEGY_DEFAULT_SL_PIPS=15.0
STRATEGY_DEFAULT_RR_RATIO=1.8
STRATEGY_SIGNAL_TTL_SECONDS=300
STRATEGY_MONITORED_SYMBOLS=EURUSD,GBPUSD,USDJPY,XAUUSD
STRATEGY_ENABLE_SESSION_FILTER=true
STRATEGY_SESSION_START_HOUR_UTC=6
STRATEGY_SESSION_END_HOUR_UTC=21
STRATEGY_MAX_CONCURRENT_POSITIONS_PER_SYMBOL=1

# Autonomous Auto-Pilot & Drawdown Guard
AUTOPILOT_DEFAULT_ENABLED=false
AUTOPILOT_MAX_DAILY_TRADES=20
AUTOPILOT_RESET_HOUR_UTC=0
AUTOPILOT_USE_FIXED_LOT=true
AUTOPILOT_FIXED_LOT_SIZE=0.01

# Telegram Notifications (Optional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_NOTIFICATIONS_ENABLED=true
